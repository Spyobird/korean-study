  "grammar": [
    {"point": "~주세요 (please give / please do)",
     "explanation": "Put a noun before 주세요 to ask for something (커피 주세요 = coffee, please). Attach it to a verb's ~아/어 form to ask someone to do something (말해 주세요 = please say it). It is the single most useful polite request pattern for daily life.",
     "examples": [
       {"ko": "아이스 아메리카노 하나 주세요.", "en": "One iced americano, please."},
       {"ko": "영수증 주세요.", "en": "The receipt, please."},
       {"ko": "천천히 말해 주세요.", "en": "Please speak slowly."},
       {"ko": "봉투 하나 주세요.", "en": "One bag, please."}
     ]},
    {"point": "~이/가 어디예요? (where is ~?)",
     "explanation": "Name the place, add the subject marker (이 after a consonant, 가 after a vowel), then 어디예요? to ask where it is. In casual speech the marker is often dropped: 화장실 어디예요?",
     "examples": [
       {"ko": "지하철역이 어디예요?", "en": "Where is the subway station?"},
       {"ko": "화장실이 어디예요?", "en": "Where is the bathroom?"},
       {"ko": "편의점이 어디예요?", "en": "Where is the convenience store?"}
     ]},
    {"point": "Polite speech: ~요 and ~습니다",
     "explanation": "Everyday polite speech ends in ~요 (해요체); use it with strangers, staff and colleagues. Shops, announcements and formal greetings use ~습니다/ㅂ니다 (합니다체). Learn to produce ~요 first and recognise ~습니다 when you hear it.",
     "examples": [
       {"ko": "이거 얼마예요?", "en": "How much is this?"},
       {"ko": "어서 오세요.", "en": "Welcome (in a shop)."},
       {"ko": "이번 역은 서울역입니다.", "en": "This stop is Seoul Station."}
     ]}
  ]
}]}
